# Copia a .env y completa los valores antes de levantar Docker o desplegar en AWS.

# Token del bot de Telegram (obligatorio)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ID del canal fuente (-100...). Dejar vacío para aceptar cualquier channel_post en local.
SOURCE_CHANNEL_ID=

# Markup aplicado a precios detectados en el mensaje
MARKUP_PERCENTAGE=15

# Retraso entre envíos (segundos). 0.05 ≈ 20 msg/seg, por debajo del límite de 30.
SEND_DELAY_SECONDS=0.05

# Secreto del webhook: el mismo valor que pasas a setWebhook (secret_token).
# Telegram lo reenvía en el header X-Telegram-Bot-Api-Secret-Token. En AWS es
# OBLIGATORIO (el endpoint es fail-closed). En local puede ir vacío si activas
# ALLOW_INSECURE_WEBHOOK=1 (docker-compose ya lo hace para el servidor de dev).
WEBHOOK_SECRET_TOKEN=

# --- Solo despliegue AWS ---
# Bucket S3 donde subirás el zip empaquetado de Lambda
# LAMBDA_CODE_S3_BUCKET=mi-bucket-deployments
