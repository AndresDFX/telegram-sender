FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY src/lambda/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt flask

COPY src/lambda /app/lambda
COPY docker/local_server.py /app/local_server.py

EXPOSE 8080

CMD ["python", "local_server.py"]
